{% extends 'base.html.twig' %}

{% block title %}Vérification admin | HaloGari{% endblock %}

{% block body %}
  <main class="auth-page">
    <section class="auth-page__card app-panel app-panel--form" style="max-width: 560px;">
      <div class="auth-form__heading">
        <span><i class="bi bi-shield-lock-fill"></i></span>
        <div>
          <h1 class="h3 mb-1">Vérification admin</h1>
          <p>Un code de sécurité a été envoyé à votre adresse e-mail.</p>
        </div>
      </div>

      <div class="alert alert-light border">
        Ce code est valable jusqu’à
        <strong>{{ expiresAt ? expiresAt|date('H:i') : 'dans quelques minutes' }}</strong>.
      </div>

      <form method="post" class="d-grid gap-3">
        <input type="hidden" name="_token" value="{{ csrf_token('admin_two_factor_verify') }}">

        <div class="form-floating">
          <input
            type="text"
            inputmode="numeric"
            pattern="[0-9]{6}"
            maxlength="6"
            class="form-control text-center fs-3 fw-bold"
            id="admin_two_factor_code"
            name="code"
            placeholder="123456"
            autocomplete="one-time-code"
            required
            autofocus
          >
          <label for="admin_two_factor_code">Code à 6 chiffres</label>
        </div>

        <button type="submit" class="btn btn-orange btn-lg">
          <i class="bi bi-check2-circle"></i>
          Valider le code
        </button>
      </form>

      <form method="post" action="{{ path('admin_two_factor_resend') }}" class="mt-3">
        <input type="hidden" name="_token" value="{{ csrf_token('admin_two_factor_resend') }}">
        <button type="submit" class="btn btn-outline-secondary w-100">
          Renvoyer un code
        </button>
      </form>

      <a href="{{ path('app_logout') }}" class="btn btn-link text-muted w-100 mt-2">Se déconnecter</a>
    </section>
  </main>
{% endblock %}
