{% extends 'base.html.twig' %}

{% block title %}HaloGari | FAQ{% endblock %}
{% block meta_description %}Questions fréquentes HaloGari : chercher un trajet, réserver, publier, vérifier son profil, installer l’application, payer et demander de l’aide.{% endblock %}

{% block body %}
<section class="app-page-header app-page-header--compact">
  <div class="container">
    <p class="app-kicker">Aide rapide</p>
    <h1>Foire aux questions</h1>
    <p>Les réponses essentielles pour utiliser HaloGari comme passager ou conducteur.</p>
  </div>
</section>

<section class="container app-page-grid">
  <div class="app-panel">
    {% set installIosGuide %}
      <div class="faq-install-guide">
        <p class="mb-3">
          Sur iPhone, HaloGari s'installe depuis le navigateur que vous utilisez, comme Safari, Chrome ou Firefox. Une fois ajoutée, l'icône apparaît sur votre écran d'accueil comme une application.
        </p>

        <div class="faq-install-steps">
          <figure class="faq-install-step">
            <img src="{{ asset('images/faq/installer-ios-1-partage.jpg') }}" alt="Bouton de partage sur iPhone" loading="lazy">
            <figcaption>
              <strong>1. Appuyez sur partager</strong>
              Ouvrez halogari.yt sur votre navigateur, puis touchez l'icône de partage.
            </figcaption>
          </figure>

          <figure class="faq-install-step">
            <img src="{{ asset('images/faq/installer-ios-2-en-voir-plus.jpg') }}" alt="Bouton En voir plus dans le menu de partage iPhone" loading="lazy">
            <figcaption>
              <strong>2. Ouvrez plus d'options</strong>
              Si l'option n'est pas visible tout de suite, touchez « En voir plus ».
            </figcaption>
          </figure>

          <figure class="faq-install-step">
            <img src="{{ asset('images/faq/installer-ios-3-ecran-accueil.jpg') }}" alt="Option Sur l'écran d'accueil sur iPhone" loading="lazy">
            <figcaption>
              <strong>3. Ajoutez à l'écran d'accueil</strong>
              Choisissez « Sur l'écran d'accueil », puis validez l'ajout de HaloGari.
            </figcaption>
          </figure>
        </div>

        <p class="faq-install-note">
          Sur Android, utilisez le bouton « Installer HaloGari » lorsqu'il apparaît, ou ouvrez le menu du navigateur puis choisissez « Installer l'application ».
        </p>
      </div>
    {% endset %}

    {% set faq = [
      {
        question: "Qui crée HaloGari ?",
        reponse: "HaloGari est une application créée par l'association WEB976 pour Mayotte. Le développement est assuré par Moussa INSSA."
      },
      {
        question: "Comment chercher un trajet ?",
        reponse: "Indiquez le village de départ, le village d'arrivée, la date et le nombre de places. Les champs de villages proposent des résultats après quelques caractères pour éviter les longues listes."
      },
      {
        question: "Comment réserver une place ?",
        reponse: "Ouvrez un trajet, choisissez le nombre de places, puis envoyez votre demande. Le conducteur peut accepter ou refuser selon les disponibilités."
      },
      {
        question: "Comment publier un trajet ?",
        reponse: "Connectez-vous, ouvrez Publier, indiquez le départ, l'arrivée, la date, l'heure, les places, le prix et les informations utiles pour les passagers."
      },
      {
        question: "Pourquoi dois-je vérifier mon profil ?",
        reponse: "La vérification aide à rassurer les autres utilisateurs. Elle permet aussi d'activer certaines fonctionnalités comme les paiements conducteur."
      },
      {
        question: "Quels documents peuvent être demandés ?",
        reponse: "Pour publier un trajet, HaloGari demande une pièce d'identité validée. Le téléphone et l'adresse postale doivent être renseignés, puis les versements conducteur sont activés via Stripe Express."
      },
      {
        question: "Comment installer HaloGari sur mon téléphone ?",
        reponse: installIosGuide
      },
      {
        question: "Les paiements sont-ils sécurisés ?",
        reponse: "Oui. Le paiement est sécurisé par HaloGari via Stripe. Après acceptation du conducteur, vous enregistrez votre paiement, puis le trajet est validé avec le code de montée. HaloGari ne stocke pas les numéros complets de carte bancaire."
      },
      {
        question: "Quand le conducteur reçoit-il son argent ?",
        reponse: "Le versement n'est pas immédiat. Après validation du trajet, HaloGari traite la part conducteur lorsque le paiement est disponible. Stripe puis la banque peuvent ajouter quelques jours avant l'arrivée de l'argent sur le compte du conducteur."
      },
      {
        question: "Quelle est la politique de remboursement ?",
        reponse: 'Elle dépend du moment de l\'annulation et de la personne qui annule. Consultez la <a href="' ~ path('app_conditionsutisation') ~ '#remboursement">politique de remboursement</a>.'
      },
      {
        question: "Comment supprimer mon compte ?",
        reponse: "Depuis Paramètres, ouvrez la zone sensible et confirmez avec votre mot de passe actuel. Le compte est désactivé pendant 15 jours, puis la suppression définitive est programmée."
      },
      {
        question: "Comment contacter le support ?",
        reponse: 'Utilisez la page <a href="' ~ path('app_contact') ~ '">Contact</a> ou écrivez à <a href="mailto:contact@halogari.yt">contact@halogari.yt</a>.'
      }
    ] %}

    <div class="accordion" id="faqAccordion">
      {% for item in faq %}
        <div class="accordion-item">
          <h2 class="accordion-header" id="heading{{ loop.index }}">
            <button class="accordion-button {% if not loop.first %}collapsed{% endif %}" type="button" data-bs-toggle="collapse" data-bs-target="#collapse{{ loop.index }}" aria-expanded="{{ loop.first ? 'true' : 'false' }}" aria-controls="collapse{{ loop.index }}">
              {{ item.question }}
            </button>
          </h2>
          <div id="collapse{{ loop.index }}" class="accordion-collapse collapse {% if loop.first %}show{% endif %}" aria-labelledby="heading{{ loop.index }}" data-bs-parent="#faqAccordion">
            <div class="accordion-body">{{ item.reponse|raw }}</div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>

  <aside class="app-panel app-tips-panel">
    <span class="app-panel__icon"><i class="bi bi-question-circle"></i></span>
    <h2>Pas trouvé ?</h2>
    <p>Envoyez-nous un message avec les détails du trajet, du compte, du paiement ou du document concerné.</p>
    <a href="{{ path('app_contact') }}" class="btn btn-orange w-100">
      <i class="bi bi-send-fill"></i>
      Contacter le support
    </a>
  </aside>
</section>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Comment chercher un trajet ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Indiquez le village de départ, le village d'arrivée, la date et le nombre de places souhaitées."
          }
        },
        {
          "@type": "Question",
          "name": "Comment réserver une place ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ouvrez un trajet, choisissez le nombre de places, puis envoyez votre demande au conducteur."
          }
        },
        {
          "@type": "Question",
          "name": "Les paiements sont-ils sécurisés ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Oui. Le paiement est sécurisé par HaloGari via Stripe. Après acceptation du conducteur, le trajet est validé avec le code de montée. HaloGari ne stocke pas les numéros complets de carte bancaire."
          }
        },
        {
          "@type": "Question",
          "name": "Quand le conducteur reçoit-il son argent ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Le versement n'est pas immédiat. Après validation du trajet, HaloGari traite la part conducteur lorsque le paiement est disponible. Stripe puis la banque peuvent ajouter quelques jours avant l'arrivée de l'argent sur le compte du conducteur."
          }
        }
      ]
    }
  </script>
{% endblock %}
