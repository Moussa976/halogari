{% extends 'base.html.twig' %}
{% import 'partials/avatar.html.twig' as avatar %}

{% block title %}HaloGari | Mon trajet{% endblock %}

{% set reservationLabels = {
  'en_attente': 'En attente',
  'acceptee': 'Acceptée',
  'payee': 'Payée',
  'refusee': 'Refusée',
  'annulee': 'Annulée'
} %}

{% set paymentLabels = {
  'en_attente': 'Paiement à venir',
  'autorise': 'Paiement enregistré',
  'capture': 'Payé',
  'rembourse_partiel': 'Remboursé partiellement',
  'rembourse': 'Remboursé',
  'echoue': 'Échoué',
  'annule': 'Annulé'
} %}

{% set activeReservations = reservations|filter(r => r.statut in ['en_attente', 'acceptee', 'payee']) %}
{% set pendingReservations = reservations|filter(r => r.statut == 'en_attente') %}
{% set reservedPlaces = activeReservations|reduce((carry, r) => carry + r.places, 0) %}

{% block body %}
<section class="app-page-header app-page-header--compact">
  <div class="container">
    <p class="app-kicker">Conducteur</p>
    <h1>{{ trajet.depart }} → {{ trajet.arrivee }}</h1>
    <p>Gérez les demandes, les passagers et les paiements de ce trajet.</p>
  </div>
</section>

<section class="container hg-account-section ride-detail {{ reservations|length > 0 ? 'ride-detail--has-reservations' : '' }}">
  <div class="ride-detail-toolbar">
    <a href="{{ path('app_mes_trajets') }}" class="reservation-back-link">
      <i class="bi bi-arrow-left"></i>
      Voir mes trajets
    </a>
    <a href="{{ path('app_user_trajet_affiche', { id: trajet.id }) }}" class="ride-detail-toolbar__button">
      <i class="bi bi-download"></i>
      Télécharger l’affiche
    </a>
  </div>

  <div class="ride-detail-layout">
    <article class="app-panel ride-detail-main">
      <div class="reservation-hero">
        <div>
          <span class="reservation-route-kicker">Trajet publié</span>
          <h2>{{ trajet.depart }} <i class="bi bi-arrow-right-short"></i> {{ trajet.arrivee }}</h2>
          <p>{{ ladateTrajet }} à {{ trajet.heureTrajet|date('H:i') }}</p>
        </div>
        {% if trajet.isAnnule() %}
          <span class="reservation-status reservation-status--annulee">
            <i class="bi bi-slash-circle-fill"></i>
            Annulé
          </span>
        {% elseif enCours %}
          <span class="reservation-status reservation-status--en_attente">
            <i class="bi bi-play-circle-fill"></i>
            En cours
          </span>
        {% elseif datePasse %}
          <span class="reservation-status reservation-status--payment-rembourse">
            <i class="bi bi-clock-history"></i>
            Passé
          </span>
        {% else %}
          <span class="reservation-status reservation-status--acceptee">
            <i class="bi bi-check-circle-fill"></i>
            Ouvert
          </span>
        {% endif %}
      </div>

      <div class="reservation-stats ride-detail-stats">
        <div class="reservation-stat">
          <span>Places restantes</span>
          <strong>{{ trajet.placesDisponibles }}</strong>
        </div>
        <div class="reservation-stat">
          <span>Places réservées</span>
          <strong>{{ reservedPlaces }}</strong>
        </div>
        <div class="reservation-stat">
          <span>Prix par place</span>
          <strong>{{ trajet.prix|number_format(2, ',', ' ') }} €</strong>
        </div>
        <div class="reservation-stat">
          <span>Demandes en attente</span>
          <strong>{{ pendingReservations|length }}</strong>
        </div>
      </div>

      <div class="ride-description-box">
        <div class="app-panel__header mb-0">
          <span class="app-panel__icon"><i class="bi bi-chat-left-text-fill"></i></span>
          <div>
            <h2>Description</h2>
            <p>Ce texte aide les passagers à décider.</p>
          </div>
        </div>
        {% if trajet.description %}
          <p>{{ trajet.description|nl2br }}</p>
        {% else %}
          <p class="text-muted mb-0">Aucune description n’a été ajoutée pour ce trajet.</p>
        {% endif %}
      </div>

      {% if not trajet.isAnnule() %}
        {% if datePasse %}
          <div class="alert alert-warning mb-0">Ce trajet est passé. Il n’est plus visible par les passagers.</div>
        {% elseif enCours %}
          <div class="alert alert-info mb-0">Ce trajet est en cours. Les nouvelles actions sont limitées.</div>
        {% else %}
          <form method="post" action="{{ path('trajet_annuler', { id: trajet.id }) }}" class="ride-cancel-form">
            <input type="hidden" name="_token" value="{{ csrf_token('annuler_trajet_' ~ trajet.id) }}">
            <button type="submit" class="btn btn-outline-danger" data-confirm="Attention : êtes-vous sûr de vouloir annuler ce trajet ? Cette action est irréversible.">
              <i class="bi bi-x-circle"></i>
              Annuler ce trajet
            </button>
          </form>
        {% endif %}
      {% else %}
        <div class="alert alert-warning mb-0">Ce trajet a été annulé. Il n’est plus visible par les passagers.</div>
      {% endif %}
    </article>

    <aside class="ride-detail-side">
      <article class="app-panel">
        <div class="app-panel__header">
          <span class="app-panel__icon"><i class="bi bi-person-badge-fill"></i></span>
          <div>
            <h2>Conducteur</h2>
            <p>Ce profil est visible par les passagers.</p>
          </div>
        </div>
        <div class="reservation-driver-card__identity">
          {{ avatar.formatSimple(trajet.conducteur, 58, 0, 1) }}
          <div>
            <span>{{ trajet.conducteur.isProfilVerifieComplet ? 'Profil vérifié' : 'Profil à compléter' }}</span>
            <strong>{{ trajet.conducteur.prenom == 'Utilisateur supprimé' ? 'Utilisateur supprimé' : trajet.conducteur.prenom }}</strong>
          </div>
        </div>
      </article>
    </aside>
  </div>

  <article class="app-panel ride-reservations-panel">
    <div class="app-panel__header">
      <span class="app-panel__icon"><i class="bi bi-people-fill"></i></span>
      <div>
        <h2>Demandes reçues</h2>
        <p>Acceptez, refusez ou contactez les passagers.</p>
      </div>
    </div>

    {% if reservations|length > 0 %}
      <div class="ride-reservation-list">
        {% for reservation in reservations %}
          {% set passengerName = reservation.passager.prenom == 'Utilisateur supprimé' ? 'Utilisateur supprimé' : reservation.passager.prenom %}
          {% set statutPaiement = reservation.paiement ? reservation.paiement.statut : 'en_attente' %}
          {% set paiementEnregistre = reservation.paiement and statutPaiement in ['autorise', 'capture', 'rembourse_partiel', 'rembourse'] %}
          {% set codeEnvoye = reservation.boardingCode is not empty %}
          {% set codeValide = reservation.boardingValidatedAt is not empty %}
          {% set versementEnvoye = reservation.paiement and (reservation.paiement.evenements|filter(e => e.type == 'versement_conducteur')|length > 0) %}
          {% set nextBadgeLabel = null %}
          {% set nextBadgeClass = null %}
          {% if versementEnvoye %}
            {% set nextBadgeLabel = 'Versement envoyé' %}
            {% set nextBadgeClass = 'payee' %}
          {% elseif codeValide %}
            {% set nextBadgeLabel = 'Code vérifié' %}
            {% set nextBadgeClass = 'payee' %}
          {% elseif codeEnvoye %}
            {% set nextBadgeLabel = 'Code à vérifier' %}
            {% set nextBadgeClass = 'action-required' %}
          {% elseif paiementEnregistre %}
            {% set nextBadgeLabel = 'Paiement enregistré' %}
            {% set nextBadgeClass = 'action-required' %}
          {% elseif reservation.statut in ['acceptee', 'payee'] %}
            {% set nextBadgeLabel = 'Paiement à venir' %}
            {% set nextBadgeClass = 'action-required' %}
          {% endif %}
          <div class="ride-reservation-card">
            <div class="ride-reservation-card__main">
              <a class="ride-reservation-card__user" href="{{ path('app_profile', { id: reservation.passager.id }) }}">
                {{ avatar.formatSimple(reservation.passager, 48, 0, 1) }}
                <div>
                  <strong>{{ passengerName }}</strong>
                  <span>{{ reservation.places }} place{{ reservation.places > 1 ? 's' : '' }} · {{ reservation.prixTotal|number_format(2, ',', ' ') }} €</span>
                </div>
              </a>

              <div class="ride-reservation-card__badges">
                <span class="reservation-status reservation-status--{{ reservation.statut }}">
                  {{ reservationLabels[reservation.statut]|default(reservation.statut|capitalize) }}
                </span>
                {% if nextBadgeLabel %}
                  <span class="reservation-status reservation-status--{{ nextBadgeClass }}">
                    {{ nextBadgeLabel }}
                  </span>
                {% endif %}
              </div>
            </div>

            <div class="ride-reservation-card__actions">
              <div class="dropdown ride-reservation-actions-menu">
                <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                  Actions
                </button>
                <div class="dropdown-menu dropdown-menu-end">
                  <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#reservationProgress{{ reservation.id }}">
                    <i class="bi bi-list-check"></i>
                    Voir la progression
                  </button>

                  <a href="{{ path('app_conversation', { userId: reservation.passager.id, trajetId: trajet.id }) }}" class="dropdown-item">
                    <i class="bi bi-chat-dots"></i>
                    Écrire
                  </a>

                  {% if reservation.statut in ['acceptee', 'payee'] and reservation.passager.telephone %}
                    <a href="tel:{{ reservation.passager.telephone }}" class="dropdown-item">
                      <i class="bi bi-telephone"></i>
                      Appeler
                    </a>
                  {% endif %}

                  {% if reservation.boardingCode and not reservation.boardingValidatedAt %}
                    <div class="dropdown-divider"></div>
                    <form method="post" action="{{ path('reservation_boarding_validate', { id: reservation.id }) }}" class="ride-reservation-menu-code-form">
                      <input type="hidden" name="_token" value="{{ csrf_token('boarding_validate_' ~ reservation.id) }}">
                      <label for="boardingCode{{ reservation.id }}">Code passager</label>
                      <div class="input-group input-group-sm">
                        <input
                          id="boardingCode{{ reservation.id }}"
                          type="text"
                          name="boarding_code"
                          class="form-control"
                          inputmode="numeric"
                          pattern="[0-9]{6}"
                          maxlength="6"
                          autocomplete="off"
                          placeholder="6 chiffres"
                          required
                        >
                        <button type="submit" class="btn btn-success">
                          Valider
                        </button>
                      </div>
                    </form>
                  {% endif %}

                  {% if reservation.statut == 'en_attente' %}
                    {% if not datePasse and not enCours %}
                      <div class="dropdown-divider"></div>
                      <form method="post" action="{{ path('reservation_accepter', { id: reservation.id }) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('reservation_action_' ~ reservation.id) }}">
                        <button type="submit" class="dropdown-item text-success">
                          <i class="bi bi-check-lg"></i>
                          Accepter
                        </button>
                      </form>
                      <form method="post" action="{{ path('reservation_refuser', { id: reservation.id }) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('reservation_action_' ~ reservation.id) }}">
                        <button type="submit" class="dropdown-item text-danger">
                          <i class="bi bi-x-lg"></i>
                          Refuser
                        </button>
                      </form>
                    {% else %}
                      <span class="dropdown-item disabled">Action indisponible</span>
                    {% endif %}
                  {% elseif datePasse and reservation.statut in ['acceptee', 'payee'] %}
                    {% set noteExistante = false %}
                    {% for note in reservation.passager.notesPour %}
                      {% if note.noteur.id == app.user.id and note.trajet.id == trajet.id %}
                        {% set noteExistante = true %}
                      {% endif %}
                    {% endfor %}
                    <div class="dropdown-divider"></div>
                    {% if not noteExistante %}
                      <a href="{{ path('app_noter_passager', { trajetId: trajet.id, passagerId: reservation.passager.id }) }}" class="dropdown-item">
                        <i class="bi bi-star"></i>
                        Noter
                      </a>
                    {% else %}
                      <span class="dropdown-item disabled">Déjà noté</span>
                    {% endif %}
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <div class="alert alert-info mb-0">Aucune demande pour ce trajet pour le moment.</div>
    {% endif %}
  </article>
</section>

{% for reservation in reservations %}
  {% set passengerName = reservation.passager.prenom == 'Utilisateur supprimé' ? 'Utilisateur supprimé' : reservation.passager.prenom %}
  {% set statutPaiement = reservation.paiement ? reservation.paiement.statut : 'en_attente' %}
  {% set paiementEnregistre = reservation.paiement and statutPaiement in ['autorise', 'capture', 'rembourse_partiel', 'rembourse'] %}
  {% set codeEnvoye = reservation.boardingCode is not empty %}
  {% set codeValide = reservation.boardingValidatedAt is not empty %}
  {% set versementEnvoye = reservation.paiement and (reservation.paiement.evenements|filter(e => e.type == 'versement_conducteur')|length > 0) %}
  <div class="modal fade ride-progress-modal" id="reservationProgress{{ reservation.id }}" tabindex="-1" aria-labelledby="reservationProgressLabel{{ reservation.id }}" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <div>
            <h3 class="modal-title h5" id="reservationProgressLabel{{ reservation.id }}">Progression de {{ passengerName }}</h3>
            <p class="mb-0 text-muted">{{ reservation.places }} place{{ reservation.places > 1 ? 's' : '' }} · {{ reservation.prixTotal|number_format(2, ',', ' ') }} €</p>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
        </div>
        <div class="modal-body">
          <div class="ride-progress-steps">
            <div class="ride-progress-step is-done">
              <span><i class="bi bi-send-check"></i></span>
              <div>
                <strong>Demande reçue</strong>
                <p>La demande du passager est enregistrée.</p>
              </div>
            </div>
            <div class="ride-progress-step {{ reservation.statut in ['acceptee', 'payee'] ? 'is-done' : (reservation.statut == 'en_attente' ? 'is-current' : '') }}">
              <span><i class="bi bi-person-check"></i></span>
              <div>
                <strong>Demande acceptée</strong>
                <p>Le passager peut payer uniquement après votre acceptation.</p>
              </div>
            </div>
            <div class="ride-progress-step {{ paiementEnregistre ? 'is-done' : (reservation.statut in ['acceptee', 'payee'] ? 'is-current' : '') }}">
              <span><i class="bi bi-credit-card"></i></span>
              <div>
                <strong>Paiement enregistré</strong>
                <p>HaloGari protège le paiement jusqu’au bon moment.</p>
              </div>
            </div>
            <div class="ride-progress-step {{ codeValide ? 'is-done' : (codeEnvoye ? 'is-current' : '') }}">
              <span><i class="bi bi-shield-check"></i></span>
              <div>
                <strong>Code de montée</strong>
                <p>{{ codeValide ? 'Le code a été validé.' : (codeEnvoye ? 'Demandez le code au passager au moment de monter.' : 'Le code sera envoyé au passager après le paiement.') }}</p>
              </div>
            </div>
            <div class="ride-progress-step {{ versementEnvoye ? 'is-done' : (codeValide ? 'is-current' : '') }}">
              <span><i class="bi bi-wallet2"></i></span>
              <div>
                <strong>Versement conducteur</strong>
                <p>{{ versementEnvoye ? 'La part conducteur a été envoyée.' : 'Le versement est traité après la fin du trajet.' }}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
{% endfor %}
{% endblock %}
